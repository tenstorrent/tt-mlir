[
    { "runs-on": ["n150","n300","llmbox"],
          "image": "speedy",
              "script": "ttrt.sh", "args": ["run", "Silicon"], "if": "mlir" },

    { "runs-on": ["n150","n300","llmbox"],
          "image": "tracy",
              "script": "ttrt.sh", "args": ["perf", "Silicon/TTNN/$RUNS_ON/perf"], "if": "mlir" },

    { "runs-on": "n150", "image": "tracy", "script": "chisel.sh", "if": "mlir" },
    { "runs-on": "n300", "image": "tracy", "script": "chisel.sh", "if": "mlir" },

    { "runs-on": "n150",
          "image": "tracy",
              "script": "test-ttrt.sh", "if": "mlir" },

    { "runs-on": "n150",
          "image": "tracy",
              "script": "pytest.sh", "args": "test/python/op_by_op", "if": "mlir" },

    { "runs-on": "n150",   "image": "tracy",
         "script": "pytest.sh", "args": "tools/explorer/test/run_tests.py",
         "reqs": "--force-reinstall $BUILD_DIR/bin/wheels/tt_adapter*.whl $BUILD_DIR/bin/wheels/ai_edge_model_explorer*.whl", "if": "mlir" },

    { "runs-on": ["llmbox","n300","n150","p150"],
          "image": "tracy",
              "script": "builder.sh", "args": ["test/python/golden", "", "run-ttrt"], "autosplit": "builder", "if": "mlir" },

    { "runs-on": "n150",   "image": "tracy",  "script": "op_model_ttrt.sh", "args": "perf", "if": "mlir"  },
    { "runs-on": "n150",   "image": "speedy",  "script": "op_model_ttrt.sh", "args": "run", "if": "mlir"  },
    { "runs-on": "n150",   "image": "speedy", "script": "op_model.sh", "if": "mlir"  },

    { "runs-on": "n150",   "image": "speedy", "script": "builder.sh", "args": [ "test/python/golden/optimizer", "", "require-opmodel" ], "if": "mlir"  },
    { "runs-on": "n150",   "image": "tracy",  "script": "ttnn_runtime.sh", "args": "runtime/test/ttnn/python/n150", "if": "mlir"  },
    { "runs-on": "n150",   "image": "tracy",  "script": "ttnn_runtime.sh", "args": "runtime/test/ttnn/python/distributed/n150", "if": "mlir"  },
    { "runs-on": "n300",   "image": "tracy",  "script": "ttnn_runtime.sh", "args": "runtime/test/ttnn/python/n300", "if": "mlir"  },
    { "runs-on": "llmbox", "image": "tracy",  "script": "ttnn_runtime.sh", "args": "runtime/test/ttnn/python/distributed/llmbox/test_multiprocess.py", "if": "mlir"  },
    { "runs-on": "llmbox", "image": "tracy",  "script": "ttnn_runtime.sh", "args": "runtime/test/ttnn/python/distributed/llmbox/test_multiprocess_tracy.py", "reqs": "websockets", "if": "mlir"  },
    { "runs-on": "llmbox", "image": "speedy", "script": "ttrt.sh", "args": ["run", "Dialect/TTNN/trace/scenarios/llmbox", "--enable-program-cache", "--loops", "3"], "if": "mlir"  },
    { "runs-on": "n300",   "image": "tracy",  "script": "runtime_debug.sh", "if": "mlir"  },
    { "runs-on": "n150",   "image": "speedy",  "script": "ttnn_standalone.sh", "if": "mlir"  },
    { "runs-on": "n150",   "image": "tracy",  "script": "pykernel.sh", "if": "mlir"  },
    { "runs-on": "n150",   "image": "tracy",  "script": "ttnn_jit.sh", "args": "nightly", "if": "ttnn-jit-nightly" },
    { "runs-on": ["n150","llmbox","p150"],   "image": "tracy",  "script": "ttnn_jit.sh", "if": "mlir"  },
    { "runs-on": ["n150","p150","n300","llmbox"],   "image": "tracy",  "script": "d2m_jit.sh", "if": "mlir"  },
    { "runs-on": "n150",   "image": "speedy",  "script": "alchemist.sh", "if": "mlir"  },
    { "runs-on": "n150",   "image": "speedy",  "script": "emitc.sh", "if": "mlir"  },

    { "runs-on": "builder",       "image": "tracy",  "script": "crank.sh", "args": "sim"  },
    { "runs-on": "llmbox",        "image": "tracy",  "script": "crank.sh", "args": "device" }
  ]
