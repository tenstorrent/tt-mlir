#!/usr/bin/env bash
# Usage: scripts/build [preset]
#
# Configure and build tt-kurbla.
#
# Arguments:
#   preset       CMake preset to use (default: debug). See CMakePresets.json.
#   -h, --help   Print this message and exit.
#
# Examples:
#   ./scripts/build
#   ./scripts/build release
#
# Runs build and symlinks build -> build_<preset>

set -euo pipefail

for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        sed -n '2,/^[^#]/{ /^#/s/^# \{0,1\}//p }' "${BASH_SOURCE[0]}"
        exit 0
    fi
done

REPO_DIR=$(realpath $(dirname "${BASH_SOURCE[0]}")/..)

if [[ ! -n "${VIRTUAL_ENV:-}" ]]; then
    echo "No virtual environment active. Please run: source venv/activate"
    exit 1
else
    echo "Active env: $VIRTUAL_ENV"
    if [[ "$VIRTUAL_ENV" != "$REPO_DIR/venv" ]]; then
        echo "Wrong venv activated. Expected $REPO_DIR/venv"
        exit 1
    fi
fi

pushd $REPO_DIR > /dev/null

PRESET="${1:-${PRESET:-debug}}" # debug build by default
echo "Build type: $PRESET"

cmake --preset "$PRESET"
cmake --build --preset "$PRESET"

ln -sfn $REPO_DIR/build_$PRESET $REPO_DIR/build

popd > /dev/null
