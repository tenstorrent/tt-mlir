#!/usr/bin/env bash
# tt-kurbla one-shot build wrapper.
#
#   ./scripts/build              # uses the "default" preset
#   ./scripts/build dev          # any preset name from CMakePresets.json
#   PRESET=san ./scripts/build   # same effect via env var
#
# Handles the pieces of friction that a raw `cmake --preset` invocation can't:
# (1) one-shot bootstrap of `.venv` for dev tooling (pre-commit hooks);
# (2) lazy `git submodule update --init --recursive` if third_party/tt-mlir is empty;
# (3) `source third_party/tt-mlir/env/activate` so $TTMLIR_TOOLCHAIN_DIR is set
#     before the tt-mlir external-project configures itself.
#
# Users who already have the env activated can skip this wrapper and run
# `cmake --preset <p>` / `cmake --build --preset <p>` / `ctest --preset <p>` directly.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Dev venv: hosts pre-commit and future tooling. Idempotent — only runs on first build.
# To refresh dev tooling, `rm -rf .venv` and re-run.
if [[ ! -d .venv ]]; then
    echo "==> bootstrapping .venv (dev tooling)"
    python3 -m venv .venv
    .venv/bin/pip install --quiet --upgrade pip
    .venv/bin/pip install --quiet -r requirements-dev.txt
    .venv/bin/pre-commit install
fi

if [[ ! -f third_party/tt-mlir/CMakeLists.txt ]]; then
    echo "==> third_party/tt-mlir missing; initializing submodules"
    git submodule update --init --recursive
fi

# Idempotent: subsequent invocations just set env vars; the first run also builds
# the LLVM/MLIR toolchain (slow, multi-GB — one time per machine).
# env/activate uses $(pwd) for TT_MLIR_HOME etc., so source it from tt-mlir's root.
# It also reads several env vars without `:-` defaults, so relax `-u` for the duration.
pushd third_party/tt-mlir > /dev/null
set +u
# shellcheck disable=SC1091
source env/activate
set -u
popd > /dev/null

PRESET="${1:-${PRESET:-default}}"

# `sim` is a test-only preset — there's no separate configure/build for it.
# Build with `default`, then have ctest set TT_KURBLA_USE_SIMULATOR=1 via the
# sim test preset so the unit-test binary routes the runtime through ttsim.
if [[ "$PRESET" == "sim" ]]; then
    cmake --preset default
    cmake --build --preset default
    ctest --preset sim
else
    cmake --preset "$PRESET"
    cmake --build --preset "$PRESET"
    ctest --preset "$PRESET"
fi
