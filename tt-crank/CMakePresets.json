{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "_base-unix",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "_gcc-base",
            "hidden": true,
            "inherits": "_base-unix",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "_clang-base",
            "hidden": true,
            "inherits": "_base-unix",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "default",
            "displayName": "Release (gcc)",
            "description": "Default Release build with gcc; the \"just works\" preset",
            "inherits": "_gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "dev",
            "displayName": "Developer (gcc, RelWithDebInfo + checks)",
            "description": "RelWithDebInfo + warnings-as-errors + clang-tidy; daily developer loop",
            "inherits": "_gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "TT_KURBLA_WARNINGS_AS_ERRORS": "ON",
                "TT_KURBLA_ENABLE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (gcc)",
            "inherits": "_gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Release (clang)",
            "description": "Release build with clang; portability sanity check",
            "inherits": "_clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Debug (clang)",
            "inherits": "_clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "san",
            "displayName": "Sanitizers (gcc, ASan + UBSan)",
            "description": "RelWithDebInfo + ASan + UBSan on first-party code; tt-mlir stays unsanitized",
            "inherits": "_gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "TT_KURBLA_ENABLE_ASAN": "ON",
                "TT_KURBLA_ENABLE_UBSAN": "ON"
            }
        },
        {
            "name": "sim",
            "displayName": "Release + ttsim runtime tests (gcc)",
            "description": "Routes runtime tests through tenstorrent/ttsim instead of opening a physical device",
            "inherits": "_gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "TT_KURBLA_ENABLE_SIMULATOR": "ON"
            }
        }
    ],
    "buildPresets": [
        {"name": "default",       "configurePreset": "default"},
        {"name": "dev",           "configurePreset": "dev"},
        {"name": "debug",         "configurePreset": "debug"},
        {"name": "clang-release", "configurePreset": "clang-release"},
        {"name": "clang-debug",   "configurePreset": "clang-debug"},
        {"name": "san",           "configurePreset": "san"},
        {"name": "sim",           "configurePreset": "sim"}
    ],
    "testPresets": [
        {"name": "default",       "configurePreset": "default",       "output": {"outputOnFailure": true}},
        {"name": "dev",           "configurePreset": "dev",           "output": {"outputOnFailure": true}},
        {"name": "debug",         "configurePreset": "debug",         "output": {"outputOnFailure": true}},
        {"name": "clang-release", "configurePreset": "clang-release", "output": {"outputOnFailure": true}},
        {"name": "clang-debug",   "configurePreset": "clang-debug",   "output": {"outputOnFailure": true}},
        {"name": "san",           "configurePreset": "san",           "output": {"outputOnFailure": true}},
        {"name": "sim",           "configurePreset": "sim",           "output": {"outputOnFailure": true}}
    ]
}
