include "ttmlir/Target/Common/types.fbs";
include "ttmlir/Target/TTNN/types.fbs";

namespace tt.target.ttnn;

table AdamWOp {
  param: tt.target.ttnn.TensorRef;
  grad: tt.target.ttnn.TensorRef;
  exp_avg: tt.target.ttnn.TensorRef;
  exp_avg_sq: tt.target.ttnn.TensorRef;
  max_exp_avg_sq: tt.target.ttnn.TensorRef;
  beta1: float;
  beta2: float;
  epsilon: float;
  weight_decay: float;
  stochastic_rounding: bool = false;
  // The tensor forms of lr / beta1_pow / beta2_pow replace the float fields
  // that used to sit above, and are appended rather than put back in place: a
  // table field's id comes from its position, so this keeps the surrounding
  // fields where they are. Dropping the three floats does renumber the fields
  // that followed them, which is fine only because nothing reads a binary
  // serialized before this change.
  beta1_pow: tt.target.ttnn.TensorRef;
  beta2_pow: tt.target.ttnn.TensorRef;
  lr: tt.target.ttnn.TensorRef;
}

table SDPAForwardOp {
  query: tt.target.ttnn.TensorRef;
  key: tt.target.ttnn.TensorRef;
  value: tt.target.ttnn.TensorRef;
  attention_mask: tt.target.ttnn.TensorRef;
  mask_type: uint32;
  dropout_probability: float;
  return_intermediates: bool = false;
  out: tt.target.ttnn.TensorRef;
  intermediates: tt.target.ttnn.TensorRef;
}
