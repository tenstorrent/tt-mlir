include "ttmlir/Target/TTNN/types.fbs";

namespace tt.target.ttnn;

// A while loop.
//
// The condition and the body are each serialized as their own top-level
// (private) program, referenced here by index and executed by a nested
// ProgramExecutor.
//
// Both sub-programs take `inits ++ captures` as their inputs. The condition
// program returns a single one-element uint32 tensor in system memory, which
// the runtime reads back to host to decide whether to keep looping; the body
// program returns the new values of the loop-carried tensors, which become the
// next iteration's `inits`.
table WhileOp {
  cond_program_id: uint32;
  body_program_id: uint32;

  // Loop-carried tensors, in their initial state. One per output.
  inits: [tt.target.ttnn.TensorRef];
  // Loop-invariant tensors the regions reference. Rebound unchanged every
  // iteration.
  captures: [tt.target.ttnn.TensorRef];
  // Loop-carried tensors after the final iteration.
  outputs: [tt.target.ttnn.TensorRef];

  // Statically known iteration count. When present the runtime skips the
  // condition program entirely. Absent means the loop is data-dependent.
  trip_count: uint64 = null;

  semaphore_inputs: [tt.target.ttnn.GlobalSemaphoreRef];
}

// An N-way branch.
//
// Each branch is serialized as its own top-level (private) program, referenced
// here by index and executed by a nested ProgramExecutor. Every branch program
// takes `captures` as its inputs and returns one value per output.
//
// The runtime reads `index` back to host and runs exactly one branch. Following
// StableHLO, an index outside `[0, len(branch_program_ids))` - which includes
// any negative one - selects the last branch.
table CaseOp {
  // Single-element si32 tensor in system memory.
  index: tt.target.ttnn.TensorRef;

  // One program id per branch, in selection order.
  branch_program_ids: [uint32];

  // Tensors the branches reference from the enclosing scope. Bound as the
  // selected branch program's inputs.
  captures: [tt.target.ttnn.TensorRef];

  // Values the selected branch produced.
  outputs: [tt.target.ttnn.TensorRef];

  semaphore_inputs: [tt.target.ttnn.GlobalSemaphoreRef];
}
